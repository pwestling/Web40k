{
  "name": "open-battle",
  "version": "0.1.0",
  "private": true,
  "description": "Open source, peer-to-peer, browser-based tabletop for miniatures wargames.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "soak": "SOAK=1 vitest run",
    "relay": "node server/relay.mjs",
    "mailbox": "node server/mailbox.mjs",
    "perf": "node scripts/perf.mjs",
    "perf:load": "node scripts/load.mjs",
    "soak:browser": "node scripts/soak-browser.mjs",
    "smoke": "node scripts/smoke.mjs",
    "i18n": "node scripts/i18n.mjs",
    "i18n:check": "node scripts/i18n.mjs --check",
    "perf:phone": "node scripts/phone.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@trystero-p2p/nostr": "^0.26.0",
    "@trystero-p2p/ws-relay": "0.26.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "meshoptimizer": "^1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "1.56.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
