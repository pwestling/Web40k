# Open Battle's web server. SITE_ADDRESS is the domain (Caddy fetches and
# renews its HTTPS certificate on its own), or e.g. http://192.168.1.20 for a
# home network without HTTPS.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Signalling (WebSocket), site config with TURN logins, and the relay's health.
	handle /relay* {
		reverse_proxy relay:8787
	}
	handle /config.json {
		reverse_proxy relay:8787
	}
	handle /health.json {
		reverse_proxy relay:8787
	}

	handle /health {
		rewrite * /health.html
		file_server {
			root /srv
		}
	}

	handle {
		root * /srv
		file_server
	}
}
