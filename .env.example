# Copy to .env and fill in. See docs/self-host.md.

# Your domain (point its DNS A/AAAA record at this machine first). Caddy gets
# the HTTPS certificate for it on its own.
DOMAIN=battle.example.com

# What Caddy serves. Normally the same as DOMAIN. For a home network without
# a domain use http://<this machine's LAN address>, e.g. http://192.168.1.20.
SITE_ADDRESS=battle.example.com

# A long random string shared by the relay and TURN, e.g. `openssl rand -hex 32`.
TURN_SECRET=change-me

# Optional. This machine's public IP, when it sits behind NAT (a home router,
# or clouds such as AWS/GCP where the public IP isn't on the network card).
TURN_EXTERNAL_IP=

# Optional. Where browsers reach TURN; defaults to turn:<DOMAIN>:3478.
# TURN_URLS=turn:battle.example.com:3478?transport=udp,turn:battle.example.com:3478?transport=tcp

# Optional. Web push for play by mail: players can be notified when it's
# their move. Make a key pair once with
#   docker compose run --rm mailbox node mailbox.mjs --vapid
# and paste both lines here. Without them, the tab title says whose move it is.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# A contact the push services can reach you at (default mailto:admin@<DOMAIN>).
# VAPID_SUBJECT=mailto:you@example.com

# Optional. Forget a mail game's mailbox after this many days untouched (60).
# MAILBOX_TTL_DAYS=60

# Optional. Open tables: a board where players post a game for anyone on your
# site to join. Off by default; "on" turns it on (kept by the relay, in memory).
# OPEN_TABLES=on

# Optional. The seed node keeps files players share (figure packs, tables,
# armies, replays) so others can fetch them after the sharer leaves. Files are
# opaque to it and may be encrypted. Where takedown notices go, and a token that
# lets you drop a file: curl -X DELETE -H "Authorization: Bearer $TOKEN" \
#   https://<DOMAIN>/seed/blob/<sha256>
# SEED_CONTACT=mailto:abuse@example.com
# SEED_ADMIN_TOKEN=
# SEED_MAX_FILE_MB=96
# SEED_MAX_TOTAL_GB=20
# SEED_TTL_DAYS=30
# SEEDER_URL=off
